# Copy to .env. Use one provider at a time. No shell expansion is performed.
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
# Chat Completions-compatible model for knowledge extraction and cited answers.
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_TIMEOUT=90

# Qwen example (China Beijing; replace URL to match your account's region):
# LLM_PROVIDER=qwen
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_API_KEY=YOUR_LOCAL_KEY

# OpenAI example (Chat Completions-compatible model):
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-5.6-terra
# LLM_API_KEY=YOUR_LOCAL_KEY

# Optional answering-only API. Leave ALL ANSWER_LLM_* unset to reuse LLM_*.
# This model synthesizes /generated-answers and selects quotes for legacy /answers.
# Setting any nonempty field enables independent config; MODEL and API_KEY are required.
# DeepSeek example (replace MODEL with one available to your account):
# ANSWER_LLM_PROVIDER=deepseek
# ANSWER_LLM_BASE_URL=https://api.deepseek.com/v1
# ANSWER_LLM_MODEL=your-deepseek-model
# ANSWER_LLM_API_KEY=
# ANSWER_LLM_TIMEOUT=90
# Qwen alternative (choose the endpoint for your account's region):
# ANSWER_LLM_PROVIDER=qwen
# ANSWER_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ANSWER_LLM_MODEL=qwen-plus
# ANSWER_LLM_API_KEY=
# ANSWER_LLM_TIMEOUT=90

# Standalone RAG service. Relative directory is resolved from launch directory.
RAG_DATA_DIR=data/rag_work
# Leave blank to generate two local tokens; view with python -m rag_service tokens.
RAG_ADMIN_TOKEN=
RAG_READ_TOKEN=
EMBEDDING_MODE=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_CACHE_DIR=data/rag_work/models
EMBEDDING_TIMEOUT=90
# Online alternative: select api, configure an embedding model (not a chat model).
# EMBEDDING_MODE=api
# EMBEDDING_BASE_URL=https://your-provider.example/v1
# EMBEDDING_MODEL=your-embedding-model
# EMBEDDING_API_KEY=

# 扫描PDF及幻灯片图片的本地OCR，默认开启
RAG_OCR_ENABLED=true

# Reference parsing (isolated environment; see docs/structured_reference.md)
RAG_REFERENCE_ENGINE=auto
DOCLING_PYTHON=.venv-docling/bin/python
# Formula generation was inaccurate/slow on the scanned textbook. Formula
# regions stay quarantined until proofread, even when generation is enabled.
DOCLING_FORMULA=false

# MA_RAG: three candidates, one review, up to two supplementary searches.
# Enable for /chat and saved conversation messages, then restart the service.
MA_RAG_ENABLED=false
