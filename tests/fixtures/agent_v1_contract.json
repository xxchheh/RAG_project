{
  "capabilities": {
    "derived": {
      "bpf_ratio": {
        "denominator": "velocity_rms",
        "formula": "sqrt(sum(numerator**2))/denominator",
        "name": "sqrt(BPF1²+BPF2²) / 速度有效值",
        "numerators": [
          "bpf1",
          "bpf2"
        ],
        "unit": "1"
      },
      "crest_factor": {
        "denominator": "acceleration_rms",
        "formula": "sqrt(sum(numerator**2))/denominator",
        "name": "加速度绝对峰值 / 加速度有效值",
        "numerators": [
          "acceleration_peak"
        ],
        "unit": "1"
      },
      "even_ratio": {
        "denominator": "velocity_rms",
        "formula": "sqrt(sum(numerator**2))/denominator",
        "name": "sqrt(A2²+A4²+A6²+A8²) / 速度有效值",
        "numerators": [
          "h2",
          "h4",
          "h6",
          "h8"
        ],
        "unit": "1"
      },
      "h1_ratio": {
        "denominator": "velocity_rms",
        "formula": "sqrt(sum(numerator**2))/denominator",
        "name": "一倍转频幅值 / 速度有效值",
        "numerators": [
          "h1"
        ],
        "unit": "1"
      },
      "h2_ratio": {
        "denominator": "velocity_rms",
        "formula": "sqrt(sum(numerator**2))/denominator",
        "name": "二倍转频幅值 / 速度有效值",
        "numerators": [
          "h2"
        ],
        "unit": "1"
      },
      "third_ratio": {
        "denominator": "velocity_rms",
        "formula": "sqrt(sum(numerator**2))/denominator",
        "name": "sqrt(A3²+A6²+A9²) / 速度有效值",
        "numerators": [
          "h3",
          "h6",
          "h9"
        ],
        "unit": "1"
      }
    },
    "device_types": {
      "coupling": "联轴器",
      "fan": "风机",
      "gearbox": "齿轮箱",
      "motor": "电机",
      "pump": "水泵"
    },
    "executes_diagnosis": false,
    "formats": [
      "md",
      "docx",
      "pdf"
    ],
    "groups": [
      "all",
      "any"
    ],
    "metrics": {
      "acceleration_peak": {
        "name": "加速度绝对峰值",
        "unit": "m/s²"
      },
      "acceleration_rms": {
        "name": "加速度有效值",
        "unit": "m/s²"
      },
      "bpf1": {
        "name": "一倍叶片通过频率速度RMS幅值",
        "unit": "mm/s"
      },
      "bpf2": {
        "name": "二倍叶片通过频率速度RMS幅值",
        "unit": "mm/s"
      },
      "h1": {
        "name": "1倍转频速度RMS幅值",
        "unit": "mm/s"
      },
      "h2": {
        "name": "2倍转频速度RMS幅值",
        "unit": "mm/s"
      },
      "h3": {
        "name": "3倍转频速度RMS幅值",
        "unit": "mm/s"
      },
      "h4": {
        "name": "4倍转频速度RMS幅值",
        "unit": "mm/s"
      },
      "h5": {
        "name": "5倍转频速度RMS幅值",
        "unit": "mm/s"
      },
      "h6": {
        "name": "6倍转频速度RMS幅值",
        "unit": "mm/s"
      },
      "h7": {
        "name": "7倍转频速度RMS幅值",
        "unit": "mm/s"
      },
      "h8": {
        "name": "8倍转频速度RMS幅值",
        "unit": "mm/s"
      },
      "h9": {
        "name": "9倍转频速度RMS幅值",
        "unit": "mm/s"
      },
      "kurtosis": {
        "name": "加速度非超额峭度",
        "unit": "1"
      },
      "low_frequency_impact": {
        "name": "低频冲击值",
        "unit": "demo_index"
      },
      "velocity_rms": {
        "name": "速度有效值",
        "unit": "mm/s"
      }
